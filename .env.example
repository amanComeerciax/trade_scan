# ==============================================================================
# TradeScan Environment Configuration
# ==============================================================================

# Database Connection (SQLite for local dev, PostgreSQL for production)
# Local SQLite (Default):
DATABASE_URL="file:./dev.db"

# Production PostgreSQL (Supabase / Neon / Railway):
# DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?schema=public"

# Cron Security Token (For automated background scraper runs via /api/cron)
CRON_SECRET="your_secure_cron_secret_here"

# Optional: Rotating Proxies Configuration (BrightData, Smartproxy, Webshare)
# PROXY_HOST="p.webshare.io"
# PROXY_PORT="80"
# PROXY_USER="username"
# PROXY_PASSWORD="password"
