generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Company {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  country           String?
  city              String?
  address           String?
  phone             String?
  contactName       String?
  contactRole       String?
  website           String?
  sourceUrl         String?
  trademapId        String?          @unique
  externalId        String?
  countryCode       String?
  activities        String?
  annualTurnover    String?
  numberOfEmployees String?
  updateDate        String?
  sourceId          Int?
  tradeFlow         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  products          CompanyProduct[]

  @@unique([name, country])
  @@index([country])
  @@index([name])
  @@index([createdAt])
}

model CompanyProduct {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId       String   @db.ObjectId
  productCategory String?
  hsCode          String?
  tradeType       String?  // Exporter, Importer, Both
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([hsCode])
  @@index([productCategory])
}

model ScrapeJob {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  status       String    // PENDING, RUNNING, COMPLETED, FAILED
  source       String
  target       String?
  recordsFound Int       @default(0)
  logs         String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([status])
  @@index([startedAt])
}
